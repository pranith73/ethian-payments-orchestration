# Normalize all text files to LF in the repository and in working copies.
* text=auto eol=lf

# Windows batch scripts must keep CRLF or cmd.exe misparses them.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
